{
  "mcpServers": {
    "archy": {
      "command": ".venv/bin/archy",
      "args": [
        "mcp"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "semgrep": {
      "command": ".venv/bin/semgrep",
      "args": [
        "mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "cclsp": {
      "command": "npx",
      "args": [
        "-y",
        "cclsp"
      ],
      "env": {
        "CCLSP_CONFIG_PATH": "/home/deck/dmarket/Dmarket_bot-main/.agents/cclsp.json"
      }
    },
    "shellcheck": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ev3lynx727/mcp-shellcheck.git@89e0b7c086dc61c5993f418cdaadd449231735da",
        "mcp-shellcheck"
      ]
    }
  }
}

{
  "mcpServers": {
    "sqlite": {
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "data/dmarket_state.db"]
    },
    "sqlite_history": {
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "data/dmarket_history.db"]
    },
    "sqlite_trading": {
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "data/dmarket_trading.db"]
    },
    "archy": {
      "command": ".venv/bin/archy",
      "args": ["mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "semgrep": {
      "command": ".venv/bin/semgrep",
      "args": ["mcp"]
    },
    "shellcheck": {
      "command": "npx",
      "args": ["-y", "github:Ev3lynx727/mcp-shellcheck"]
    }
  }
}

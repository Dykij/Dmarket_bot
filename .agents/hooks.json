{
  "validate-skills-frontmatter": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash scripts/validate_skills_frontmatter.sh",
        "timeout": 5
      }
    ]
  },
  "verdict-gate": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash scripts/verdict_gate.sh",
        "timeout": 10
      }
    ]
  },
  "raw-output-logger": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/raw_output_logger.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "pre-danger-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/pre_danger_gate.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "implementation-plan-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/implementation_plan_guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "task-md-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash pre_tool_use.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "bash scripts/stop_gate.sh",
        "timeout": 15
      }
    ]
  },
  "pre-bypass-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/pre_bypass_gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
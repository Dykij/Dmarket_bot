{
    "validate-skills-frontmatter": {
        "SessionStart": [
            {
                "type": "command",
                "command": "bash scripts/validate_skills_frontmatter.sh",
                "timeout": 5
            }
        ]
    },
    "verdict-gate": {
        "PreInvocation": [
            {
                "type": "command",
                "command": "bash scripts/verdict_gate.sh",
                "timeout": 10
            }
        ]
    },
    "raw-output-logger": {
        "PostToolUse": [
            {
                "matcher": "run_command",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash scripts/raw_output_logger.sh",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "pre-danger-gate": {
        "PreToolUse": [
            {
                "matcher": "run_command",

{
  "session-log-reminder": {
    "Stop": [
      {
        "type": "command",
        "command": "bash .agents/scripts/check_session_log.sh",
        "timeout": 10
      }
    ]
  },
  "verdict-gate": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash .agents/scripts/verdict_gate.sh",
        "timeout": 10
      }
    ]
  }
}

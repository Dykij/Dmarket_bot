                    {
                        "type": "command",
                        "command": "bash scripts/pre_danger_gate.sh",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "implementation-plan-guard": {
        "PreToolUse": [
            {
                "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
